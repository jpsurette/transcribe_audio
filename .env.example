API_KEY = xxxxxxxxxxxxxx

# Optional directory overrides. Leave commented out to use the repo defaults.
# Paths may use ~ ; relative paths are resolved against the repo directory.
# Command-line flags (--inputs-dir, --raw-dir, --cleaned-dir) override these.
# TRANSCRIBE_INPUTS_DIR = ~/Dropbox/Dictation          # default: inputs/
# TRANSCRIBE_RAW_DIR = ~/Dropbox/Dictation/raw         # default: outputs/raw/
# TRANSCRIBE_CLEANED_DIR = ~/Documents/Notes/Dictation # default: outputs/cleaned/
